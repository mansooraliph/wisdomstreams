DATABASE_URL="postgresql://wisdomstream:wisdomstream@localhost:5434/wisdomstream"
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003
WEB_APP_URL=http://localhost:3000
STUDIO_APP_URL=http://localhost:3002

REDIS_URL=redis://localhost:6379

# Leave unset in local dev. In production set to the shared parent domain
# (e.g. ".wisdomstream.com") so auth cookies are visible to both api.* and
# the main app's subdomains.
COOKIE_DOMAIN=

# Generate strong random secrets for these in any real deployment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# From resend.com. Left empty, auth emails (verification, password reset)
# just get logged to the console instead of actually sending.
RESEND_API_KEY=
# onboarding@resend.dev works without verifying a domain, but Resend will
# only let you send to your own account's email in that mode. Verify a
# domain in the Resend dashboard and use an address on it for real sending.
EMAIL_FROM="WisdomStream <onboarding@resend.dev>"

# From your Mux dashboard (mux.com). Video upload/streaming/webhooks won't
# work without these — MuxService throws a clear error if they're missing.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=wisdomstream
MINIO_SECRET_KEY=wisdomstream123
MINIO_BUCKET_AVATARS=wisdomstream-avatars
MINIO_BUCKET_BANNERS=wisdomstream-banners
MINIO_BUCKET_THUMBNAILS=wisdomstream-thumbnails
CDN_URL=http://localhost:9000

ELASTICSEARCH_URL=http://localhost:9200
